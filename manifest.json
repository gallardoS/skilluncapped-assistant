{
    "manifest_version": 3,
    "name": "SkillUncapped Assistant",
    "version": "1.5.1",
    "description": "enhances the workflow and user experience for skilluncapped via cross-site automation and built-in cors disabler",
    "icons": {
        "16": "icons/icon16.png",
        "32": "icons/icon32.png",
        "48": "icons/icon48.png",
        "128": "icons/icon128.png"
    },
    "permissions": [
        "declarativeNetRequest",
        "storage"
    ],
    "host_permissions": [
        "<all_urls>"
    ],
    "declarative_net_request": {
        "rule_resources": [
            {
                "id": "ruleset_1",
                "enabled": true,
                "path": "src/rules.json"
            }
        ]
    },
    "action": {
        "default_icon": {
            "16": "icons/icon16.png",
            "32": "icons/icon32.png",
            "48": "icons/icon48.png",
            "128": "icons/icon128.png"
        }
    },
    "background": {
        "scripts": [
            "src/ReleaseUpdateChecker.js",
            "src/background.js"
        ],
        "service_worker": "src/background.js"
    },
    "browser_specific_settings": {
        "gecko": {
            "id": "skilluncapped-assistant@gallardos.github.io",
            "strict_min_version": "128.0",
            "data_collection_permissions": {
                "required": [
                    "none"
                ]
            }
        }
    },
    "content_scripts": [
        {
            "matches": [
                "*://*.skill-capped.com/*"
            ],
            "js": [
                "src/scanners/components/PlayButtonComponent.js",
                "src/scanners/NavigationHandler.js",
                "src/scanners/CardScanner.js",
                "src/scanner-main.js"
            ],
            "css": [
                "src/content.css"
            ]
        },
        {
            "matches": [
                "*://skilluncapped.netlify.app/*"
            ],
            "js": [
                "src/automator/AdjacentVideoPreloader.js",
                "src/automator/VideoGesturesController.js",
                "src/automator/WindowOverrides.js",
                "src/automator/ui/SidebarInjector.js",
                "src/automator/ui/DownloadDialogInjector.js",
                "src/automator/ui/TheaterModeController.js",
                "src/automator/ui/ControlsInjector.js",
                "src/automator/VideoController.js",
                "src/automator/ui/WatchLayout.js",
                "src/automator-main.js"
            ],
            "css": [
                "src/content.css"
            ],
            "run_at": "document_start",
            "world": "MAIN"
        },
        {
            "matches": [
                "*://skilluncapped.netlify.app/*"
            ],
            "js": [
                "src/update-checker.js"
            ],
            "run_at": "document_idle"
        }
    ]
}
